<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Witch-Rus-Patcher</AssemblyName>
    <RootNamespace>WitchRusPatcher</RootNamespace>
    <StartupObject>WitchRusPatcher.Program</StartupObject>
    <BaseOutputPath>obj\build_out\</BaseOutputPath>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- Иконка и метаданные приложения -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AssemblyTitle>Русификатор Witch's Apocalyptic Journey</AssemblyTitle>
    <Title>Русификатор Witch's Apocalyptic Journey</Title>
    <Product>Русификатор Witch's Apocalyptic Journey</Product>
    <Description>Автоматический установщик и обновитель русификатора для Witch's Apocalyptic Journey</Description>
    <FileDescription>Русификатор Witch's Apocalyptic Journey</FileDescription>
    <Company>CTAK-CO6AK</Company>
    <Authors>CTAK-CO6AK</Authors>
    <Copyright>Copyright © 2026 CTAK-CO6AK</Copyright>
    <RepositoryUrl>https://github.com/CTAK-CO6AK/rus-witchs-apocalyptic-journey</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AssetsTools.NET">
      <HintPath>AssetsTools.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

</Project>
